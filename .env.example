# Copy to .env and fill in real values. Never commit .env or real secrets.

MONGODB_URI=
MONGODB_DB_NAME=repomate_lite

EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Free-tier open-weight inference provider only (e.g. Groq, Together, HF Inference) — no paid LLM APIs.
LLM_PROVIDER=
LLM_MODEL_NAME=
LLM_API_KEY=

# Optional: raises GitHub API rate limits for ingestion; not required for public repos.
GITHUB_TOKEN=

# Demo repo size cap per CLAUDE.md — larger repos are a documented limitation, not a bug.
MAX_REPO_FILES=150

APP_ENV=development
